ENVIRONMENT=development
JWT_SECRET=dev-insecure-jwt-secret-change-me
JWT_ALGORITHM=HS256
JWT_ISSUER=classledger
JWT_AUDIENCE=classledger-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TTL_HEAD_TEACHER_SECONDS=1209600
REFRESH_TTL_STUDENT_SECONDS=604800
BCRYPT_ROUNDS=12
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000"]
MAX_FAILED_ATTEMPTS=5
LOCKOUT_SECONDS=900

# Optional. When set, startup checks the connection and validates tables exist.
# Copy to .env and replace with your real URL. Never commit credentials.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
